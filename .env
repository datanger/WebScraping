# 登录凭据
SP_LOGIN_EMAIL=user@example.com
SP_LOGIN_PASSWORD=your_password
SP_TARGET_URL=https://contoso.sharepoint.com/sites/MySite

# 会话存储
SP_STORAGE_STATE=storage/storage_state.json

# 浏览器设置
SP_HEADLESS=true
SP_SLOWMO_MS=0
SP_PROXY=

# 超时设置
SP_TIMEOUT_MS=30000

# MFA 设置
SP_MFA_PROVIDER=manual  # manual|totp|imap
SP_TOTP_SECRET=your_totp_secret

# IMAP 设置（当使用 IMAP 验证码时）
SP_IMAP_HOST=imap.gmail.com
SP_IMAP_USER=your_email@gmail.com
SP_IMAP_PASSWORD=your_app_password
SP_IMAP_FOLDER=INBOX
SP_IMAP_SSL=true
SP_IMAP_SUBJECT_KW=Microsoft 验证码

# 下载设置
SP_DOWNLOAD_METHOD=browser_default
SP_DOWNLOAD_PATH=downloads

# SharePoint 批量下载配置
# 并行下载数量（默认2个）
BATCH_DOWNLOAD_CONCURRENCY=2

# 安全模式配置
SP_TEST_MODE=true

