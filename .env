# SharePoint自动化配置
# 所有配置参数都在这里统一管理

# ==================== 登录/目标设置 ====================
SP_LOGIN_EMAIL=
SP_LOGIN_PASSWORD=
SP_TARGET_URL=https://scautoeng.sharepoint.com/sites/KOTEI-SCAE/Shared%20Documents/Forms/AllItems.aspx?id=%2Fsites%2FKOTEI%2DSCAE%2FShared%20Documents%2FGEN1%2E5%E4%B8%AD%E5%9B%BDFOT%2F%E3%83%87%E3%83%BC%E3%82%BF%E8%A7%A3%E6%9E%90%2F%E8%AA%8D%E8%AD%98%E7%B3%BB%2F%E8%B5%B0%E8%B7%AF%E8%AA%8D%E8%AD%98%2F%E3%82%B9%E3%82%AF%E3%83%AA%E3%83%97%E3%83%88%E6%A4%9C%E8%A8%8E%2FTest&viewid=8e19c37a%2Dacdb%2D4c40%2Da22e%2D92e27e7e3366&csf=1&web=1&e=NWcbWt&FolderCTID=0x01200090D0082931AED242A8680C59FF4AF68D

# ==================== 存储设置 ====================
SP_STORAGE_STATE=storage/storage_state.json

# ==================== 浏览器设置 ====================
SP_HEADLESS=true
SP_SLOWMO_MS=0
SP_PROXY=
SP_BROWSER_TYPE=chromium
SP_PERSISTENT_MODE=false
SP_USER_DATA_DIR=storage/browser_profile

# ==================== 超时设置 ====================
SP_TIMEOUT_MS=30000

# ==================== MFA/OTP设置 ====================
SP_MFA_PROVIDER=manual
SP_TOTP_SECRET=

# IMAP设置（用于自动获取验证码）
SP_IMAP_HOST=
SP_IMAP_USER=
SP_IMAP_PASSWORD=
SP_IMAP_FOLDER=INBOX
SP_IMAP_SSL=true
SP_IMAP_SUBJECT_KW=Microsoft 验证码

# ==================== 下载设置 ====================
SP_DOWNLOAD_METHOD=browser_default
SP_DOWNLOAD_PATH=

# ==================== 批量下载设置 ====================
BATCH_DOWNLOAD_CONCURRENCY=2

# ==================== 搜索路径设置 ====================
SP_SEARCH_PATH_SEPARATOR=auto
SP_USE_WINDOWS_PATH_LOGIC=true
SP_SEARCH_TIMEOUT=30
